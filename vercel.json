{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/bakery.js": { "includeFiles": "db/{schema,data}.sql", "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/api/:route*", "destination": "/api/bakery?route=:route*" }
  ]
}
