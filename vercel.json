{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/tables", "destination": "/api/bakery-proxy?route=tables" },
    { "source": "/api/catalog", "destination": "/api/bakery-proxy?route=catalog" },
    { "source": "/api/players/:path*", "destination": "/api/bakery-proxy?route=players/:path*" }
  ]
}
